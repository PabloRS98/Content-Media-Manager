# Copy this file to .env and fill in what you need.
# Every value below is optional — the app runs with zero configuration
# and zero paid APIs. Missing keys just disable that one metadata source.

APP_NAME="Media Catalog"

# --- Where the port is published ---
# Loopback by default: the catalog is personal information and the app lets
# anyone who can reach it delete everything. Set MEDIA_BIND to 0.0.0.0 to serve
# the whole network (do that only behind a reverse proxy or a VPN), or to the
# address of one specific interface. Turn ENABLE_AUTH on at the same time.
MEDIA_BIND=127.0.0.1
MEDIA_PORT=8002

# --- Optional HTTP Basic auth (turn it on whenever the app leaves localhost) ---
# With ENABLE_AUTH=true the app REFUSES TO START if AUTH_PASSWORD is still the
# factory value ('changeme') or is shorter than 8 characters. Failing loudly at
# boot takes a minute to fix; an exposed app with admin/changeme can go
# unnoticed for months.
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Extra hosts allowed as the origin of write requests (CSRF check) ---
# Only needed if you reach the app under a name the reverse proxy doesn't set
# as Host. Comma-separated. Automated clients (curl, scripts) must send an
# Origin or Referer header: requests with none are rejected.
TRUSTED_ORIGINS=

# --- Database ---
DB_PATH=/data/media.db
BACKUP_KEEP=14

# --- Free metadata APIs (all optional, all have a free tier) ---
# Open Library (books) needs no key — always on.
#
# TMDB (movies/series posters, cast, episodes, release dates):
# 1. Create a free account at https://www.themoviedb.org/
# 2. Go to Settings -> API -> request a free "Developer" API key (v3 auth)
# 3. Paste it below
TMDB_API_KEY=

# RAWG (video game covers/metadata):
# 1. Create a free account at https://rawg.io/apidocs
# 2. Generate an API key from your account dashboard
RAWG_API_KEY=

# Google Books (book fallback/enrichment): works without a key at low volume.
# For a higher free quota, create a key at https://console.cloud.google.com/
# (enable the "Books API" and generate an API key under Credentials).
GOOGLE_BOOKS_API_KEY=

# --- Timezone for scheduled jobs (episode/release alerts, daily backup) ---
TIMEZONE=UTC

# --- Optional Telegram notifications (new episodes, wishlist releases) ---
# 1. Talk to @BotFather on Telegram, create a bot, copy the token it gives you
# 2. Send your bot any message, then check https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
