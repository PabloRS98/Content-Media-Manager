# Copy this file to .env and fill in what you need.
# Every value below is optional — the app runs with zero configuration
# and zero paid APIs. Missing keys just disable that one metadata source.

APP_NAME="Media Catalog"

# --- Optional HTTP Basic auth (recommended if you expose this beyond your LAN) ---
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Database ---
DB_PATH=/data/media.db
BACKUP_KEEP=14

# --- Limits ---
# Max size (MB) of a CSV upload to the importer.
MAX_UPLOAD_MB=20

# Background jobs (episode/release alerts + daily backup). The scheduler starts
# once per uvicorn worker, so if you ever run with --workers N, set this to false
# on all but one process to avoid duplicate backups and duplicate alerts.
ENABLE_SCHEDULER=true

# --- Free metadata APIs (all optional, all have a free tier) ---
# Open Library (books) needs no key — always on.
#
# TMDB (movies/series posters, cast, episodes, release dates):
# 1. Create a free account at https://www.themoviedb.org/
# 2. Go to Settings -> API -> request a free "Developer" API key (v3 auth)
# 3. Paste it below
TMDB_API_KEY=

# RAWG (video game covers/metadata):
# 1. Create a free account at https://rawg.io/apidocs
# 2. Generate an API key from your account dashboard
RAWG_API_KEY=

# Google Books (book fallback/enrichment): works without a key at low volume.
# For a higher free quota, create a key at https://console.cloud.google.com/
# (enable the "Books API" and generate an API key under Credentials).
GOOGLE_BOOKS_API_KEY=

# --- Timezone for scheduled jobs (episode/release alerts, daily backup) ---
TIMEZONE=UTC

# --- Optional Telegram notifications (new episodes, wishlist releases) ---
# 1. Talk to @BotFather on Telegram, create a bot, copy the token it gives you
# 2. Send your bot any message, then check https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
